<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
../../Eavesdropper.xsd">

	<!-- The window itself: background, border, title and close button. Everything inside
		it is built in CopyHistoryDialog.lua -->
	<Frame name="Eavesdropper_CopyHistoryDialogTemplate" inherits="Eavesdropper_UIFrameTemplate" mixin="Eavesdropper_CopyHistoryDialogMixin" virtual="true" enableMouse="true" hidden="true" registerForDrag="LeftButton" movable="true" clampedToScreen="true" frameStrata="DIALOG">
		<Size x="600" y="600"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<Frame parentKey="LoadingSpinner" inherits="SpinnerTemplate" hidden="true">
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Size x="54" y="54"/>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
		</Scripts>
	</Frame>
</Ui>
