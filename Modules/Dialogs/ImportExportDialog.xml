<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
../../Eavesdropper.xsd">

	<!-- The window itself: background, border, title and close button. Everything inside
		it is built in ImportExportDialog.lua -->
	<Frame name="Eavesdropper_ImportExportDialogTemplate" inherits="Eavesdropper_UIFrameTemplate" mixin="Eavesdropper_ImportExportDialogMixin" virtual="true" enableMouse="true" hidden="true" registerForDrag="LeftButton" movable="true" clampedToScreen="true" frameStrata="DIALOG">
		<Size x="400" y="380"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>
</Ui>
